FROM orders;

-- 15. RANK BASED ON CUSTOMER NAME
SELECT *,
RANK() OVER(ORDER BY customer_name) AS rank_num
FROM orders;

-- 16. RANK WITHIN CITY BASED ON ORDER DATE
SELECT *,
RANK() OVER(PARTITION BY city ORDER BY order_date) AS rank_num
FROM orders;

-- 17. DENSE_RANK BASED ON AMOUNT DESC
SELECT *,
DENSE_RANK() OVER(ORDER BY amount DESC) AS dense_rank_num
FROM orders;

-- 18. DENSE_RANK WITHIN CITY BASED ON AMOUNT
