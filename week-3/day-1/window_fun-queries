-- 1. ROW_NUMBER BASED ON AMOUNT (HIGHEST FIRST)
SELECT *,
ROW_NUMBER() OVER(ORDER BY amount DESC) AS row_num
FROM orders;

-- 2. ROW_NUMBER WITHIN CITY BASED ON AMOUNT DESC
SELECT *,
ROW_NUMBER() OVER(PARTITION BY city ORDER BY amount DESC) AS row_num
FROM orders;

-- 3. ROW_NUMBER BASED ON ORDER DATE (LATEST FIRST)
SELECT *,
ROW_NUMBER() OVER(ORDER BY order_date DESC) AS row_num
FROM orders;

-- 4. ROW_NUMBER WITHIN CITY BASED ON EARLIEST ORDER DATE
SELECT *,
ROW_NUMBER() OVER(PARTITION BY city ORDER BY order_date ASC) AS row_num
FROM orders;

-- 5. ROW_NUMBER BASED ON ORDER DATE
SELECT *,
ROW_NUMBER() OVER(ORDER BY order_date) AS row_num
FROM orders;

-- 6. ROW_NUMBER WITHIN CITY BASED ON ORDER AMOUNT
SELECT *,
ROW_NUMBER() OVER(PARTITION BY city ORDER BY amount DESC) AS row_num
FROM orders;

-- 7. ROW_NUMBER BASED ON AMOUNT (LOWEST FIRST)
SELECT *,
ROW_NUMBER() OVER(ORDER BY amount ASC) AS row_num
FROM orders;

-- 8. ROW_NUMBER WITHIN CITY BASED ON CUSTOMER NAME
SELECT *,
ROW_NUMBER() OVER(PARTITION BY city ORDER BY customer_name) AS row_num
FROM orders;

-- 9. RANK BASED ON AMOUNT DESC
SELECT *,
RANK() OVER(ORDER BY amount DESC) AS rank_num
FROM orders;

-- 10. RANK WITHIN CITY BASED ON AMOUNT
SELECT *,
RANK() OVER(PARTITION BY city ORDER BY amount DESC) AS rank_num
FROM orders;

-- 11. RANK BASED ON ORDER DATE DESC
SELECT *,
RANK() OVER(ORDER BY order_date DESC) AS rank_num
FROM orders;

-- 12. RANK BASED ON ORDER AMOUNT
SELECT *,
RANK() OVER(ORDER BY amount DESC) AS rank_num
FROM orders;

-- 13. RANK WITHIN CITY BASED ON ORDER AMOUNT
