-- 1. SHOW EMPLOYEES WITH NULL SALARY
SELECT *
FROM Employees
WHERE salary IS NULL;

-- 2. SHOW ORDERS WITH NON-NULL DISCOUNT
SELECT *
FROM Orders
WHERE discount IS NOT NULL;

-- 3. SHOW PRODUCTS WITH NULL CATEGORY
SELECT *
FROM Products
WHERE category IS NULL;

-- 4. COUNT EMPLOYEES WITH NULL MANAGER
SELECT COUNT(*)
FROM Employees
WHERE manager_id IS NULL;

-- 5. REPLACE NULL SALARY WITH 0
SELECT emp_id, name, IFNULL(salary, 0)
FROM Employees;

-- 6. REPLACE NULL BONUS WITH 1000
SELECT emp_id, name, IFNULL(bonus, 1000)
FROM Employees;

-- 7. REPLACE NULL ORDER AMOUNT WITH 500
SELECT order_id, IFNULL(amount, 500)
FROM Orders;

-- 8. REPLACE NULL STOCK WITH 0
SELECT product_id, IFNULL(stock, 0)
FROM Products;

-- 9. SHOW EMPLOYEE EARNINGS USING SALARY OR BONUS
SELECT name,
COALESCE(salary, bonus)
FROM Employees;

-- 10. SHOW FIRST AVAILABLE VALUE (SALARY → BONUS → 0)
SELECT name,
COALESCE(salary, bonus, 0)
FROM Employees;

-- 11. SHOW PRODUCT PRICE OR DEFAULT 1000
SELECT product_name,
COALESCE(price, 1000)
FROM Products;

-- 12. GET CUSTOMER PAYMENT
SELECT customer_name,
COALESCE(amount, discount, 0)
FROM Orders;

-- 13. CONVERT SALARY TO NULL IF SALARY = 0
SELECT name,
NULLIF(salary, 0)
FROM Employees;

-- 14. CONVERT DISCOUNT TO NULL IF DISCOUNT = 0
SELECT order_id,
NULLIF(discount, 0)
FROM Orders;

-- 15. AVOID DIVIDE BY ZERO
SELECT amount / NULLIF(discount, 0)
FROM Orders;

-- 16. REPLACE COUPON CODE WITH NULL IF DISC10
SELECT order_id,
NULLIF(coupon_code, 'DISC10')
FROM Orders;

-- 17. CALCULATE TOTAL EARNINGS
SELECT name,
COALESCE(salary, 0) + COALESCE(bonus, 0) AS total_earnings
FROM Employees;

-- 18. EMPLOYEES WITH BOTH SALARY AND BONUS NULL
SELECT *
FROM Employees
WHERE salary IS NULL
AND bonus IS NULL;

-- 19. PRODUCTS WITH NULL PRICE BUT VALID CATEGORY
SELECT *
FROM Products
WHERE price IS NULL
AND category IS NOT NULL;

-- 20. ORDERS WITH BOTH AMOUNT AND DISCOUNT NULL
SELECT *
FROM Orders
WHERE amount IS NULL
AND discount IS NULL;

-- 21. SHOW EMPLOYEE INCOME
SELECT name,
COALESCE(salary, bonus, 1000)
FROM Employees;

-- 22. REPLACE EMPTY DISCOUNT WITH NULL
SELECT order_id,
NULLIF(discount, 0)
FROM Orders;

-- 23. SHOW FINAL PAYABLE AMOUNT
SELECT order_id,
COALESCE(amount, 0) - COALESCE(discount, 0) AS payable_amount
FROM Orders;

-- 24. EMPLOYEES WHERE SALARY IS NULL BUT MANAGER EXISTS
SELECT *
FROM Employees
WHERE salary IS NULL
AND manager_id IS NOT NULL;
