-- 1. EXTRACT DIGITS
SELECT sample_text,
REGEXP_SUBSTR(sample_text,'[0-9]')
FROM email_data;

-- 2. EXTRACT ALPHABETS
SELECT sample_text,
REGEXP_SUBSTR(sample_text,'[A-Za-z]')
FROM email_data;

-- 3. START OF STRING (^)
SELECT sample_text,
REGEXP_SUBSTR(sample_text,'^[0-9]')
FROM email_data;

-- 4. END OF STRING ($)
SELECT sample_text,
REGEXP_SUBSTR(sample_text,'[0-9]$')
FROM email_data;

-- 5. EXACTLY TWO DIGITS
SELECT sample_text,
REGEXP_SUBSTR(sample_text,'[0-9]{2}')
FROM email_data;

-- 6. EXACTLY TWO ALPHABETS
SELECT sample_text,
REGEXP_SUBSTR(sample_text,'[A-Za-z]{2}')
FROM email_data;

-- 7. ONE OR MORE DIGITS
SELECT sample_text,
REGEXP_SUBSTR(sample_text,'[0-9]+')
FROM email_data;

-- 8. ONE OR MORE ALPHABETS
SELECT sample_text,
REGEXP_SUBSTR(sample_text,'[A-Za-z]+')
FROM email_data;

-- 9. EXTRACT ALPHANUMERIC DATA
SELECT sample_text,
REGEXP_SUBSTR(sample_text,'[0-9A-Za-z]+')
FROM email_data;

-- 10. EXTRACT DOMAIN PART
SELECT email,
REGEXP_SUBSTR(email,'@[A-Za-z.]+')
FROM email_data;

-- 11. EXTRACT TOP LEVEL DOMAIN
SELECT email,
REGEXP_SUBSTR(email,'\\.[A-Za-z]+$')
FROM email_data;

-- 12. EXTRACT PHONE NUMBER
SELECT phone_number,
REGEXP_SUBSTR(phone_number,'\\+91-[0-9]{10}')
FROM email_data;

-- 13. REMOVE @ FROM DOMAIN
SELECT email,
REPLACE(
REGEXP_SUBSTR(email,'@[A-Za-z.]+'),
'@',
''
)
FROM email_data;

-- 14. VALIDATE EMAIL FORMAT
SELECT email,
CASE
WHEN email REGEXP '[A-Za-z0-9._-]+@[A-Za-z0-9]+\\.[A-Za-z]{2,3}'
THEN 'VALID'
ELSE 'INVALID'
END AS email_status
FROM email_data;

-- 15. EXTRACT USERNAME
SELECT email,
REGEXP_SUBSTR(email,'^[A-Za-z0-9._-]+')
FROM email_data;

-- 16. EXTRACT DOMAIN NAME
SELECT email,
REGEXP_SUBSTR(email,'@[A-Za-z0-9]+')
FROM email_data;

-- 17. EXTRACT EXTENSION
SELECT email,
REGEXP_SUBSTR(email,'[A-Za-z]{2,3}$')
FROM email_data;

-- 18. EMAILS STARTING WITH K
SELECT email
FROM email_data
WHERE email REGEXP '^k';

-- 19. EMAILS ENDING WITH .COM
SELECT email
FROM email_data
WHERE email REGEXP '\\.com$';

-- 20. EMAILS CONTAINING NUMBERS
SELECT email
FROM email_data
WHERE email REGEXP '[0-9]';
