-- 1. DIGITS AT THE BEGINNING
SELECT mixed_value,
REGEXP_SUBSTR(mixed_value,'^[0-9]+')
FROM regex_practice;

-- 2. DIGITS AT THE END
SELECT mixed_value,
REGEXP_SUBSTR(mixed_value,'[0-9]+$')
FROM regex_practice;

-- 3. FIRST CHARACTER
SELECT mixed_value,
REGEXP_SUBSTR(mixed_value,'^.')
FROM regex_practice;

-- 4. LAST CHARACTER
SELECT mixed_value,
REGEXP_SUBSTR(mixed_value,'.$')
FROM regex_practice;

-- 5. EXACTLY TWO DIGITS
SELECT mixed_value,
REGEXP_SUBSTR(mixed_value,'[0-9]{2}')
FROM regex_practice;

-- 6. EXACTLY ONE DIGIT
SELECT mixed_value,
REGEXP_SUBSTR(mixed_value,'[0-9]')
FROM regex_practice;

-- 7. COUNTRY CODE FROM PHONE
SELECT phone,
REGEXP_SUBSTR(phone,'[0-9]+')
FROM regex_practice;

-- 8. NUMERIC PORTION BETWEEN ALPHABETS
SELECT mixed_value,
REGEXP_SUBSTR(mixed_value,'[0-9]+')
FROM regex_practice;

-- 9. TEXT BEFORE @
SELECT email,
REGEXP_SUBSTR(email,'^[^@]+')
FROM regex_practice;

-- 10. TEXT AFTER @
SELECT email,
REGEXP_SUBSTR(email,'@.*')
FROM regex_practice;

-- 11. DOMAIN WITHOUT @
SELECT email,
REPLACE(REGEXP_SUBSTR(email,'@.*'),'@','')
FROM regex_practice;

-- 12. TEXT AFTER LAST DOT
SELECT email,
REGEXP_SUBSTR(email,'[^.]+$')
FROM regex_practice;

-- 13. CONTINUOUS ALPHABETS
SELECT mixed_value,
REGEXP_SUBSTR(mixed_value,'[A-Za-z]+')
FROM regex_practice;

-- 14. CONTINUOUS DIGITS
SELECT mixed_value,
REGEXP_SUBSTR(mixed_value,'[0-9]+')
FROM regex_practice;

-- 15. FIRST THREE CHARACTERS
SELECT full_text,
REGEXP_SUBSTR(full_text,'^...')
FROM regex_practice;

-- 16. LAST TWO CHARACTERS
SELECT full_text,
REGEXP_SUBSTR(full_text,'..$')
FROM regex_practice;

-- 17. EMPLOYEE NUMBER BETWEEN PREFIX AND _
SELECT full_text,
REGEXP_SUBSTR(full_text,'[0-9]+')
FROM regex_practice;

-- 18. COUNTRY CODE AT END
SELECT full_text,
REGEXP_SUBSTR(full_text,'[A-Z0-9]+$')
FROM regex_practice;

-- 19. TEXT BETWEEN UNDERSCORES
SELECT full_text,
REGEXP_SUBSTR(full_text,'_[A-Z]+_')
FROM regex_practice;

-- 20. COUNTRY CODE AFTER +
SELECT phone,
REGEXP_SUBSTR(phone,'(?<=\\+)[0-9]+')
FROM regex_practice;
