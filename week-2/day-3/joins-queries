-- 22. EMPLOYEE COUNT BY DEPARTMENT
SELECT d.dept_name,
COUNT(e.emp_id) AS employee_count
FROM departments d
LEFT JOIN employees e
ON d.dept_id = e.dept_id
GROUP BY d.dept_name;

